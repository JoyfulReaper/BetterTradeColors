<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.7</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BetterTradeColors</RootNamespace>
    <AssemblyName>BetterTradeColors</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath Condition="'$(RimWorldVersion)' == '1.7'">..\1.7\Assemblies\</OutputPath>
    <OutputPath Condition="'$(RimWorldVersion)' == '1.6'">..\Common\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <Import Project="RimWorldReferences.props" />
</Project>
